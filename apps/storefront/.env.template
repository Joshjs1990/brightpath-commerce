# Publishable API key from Medusa Admin > Settings > Publishable API keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Local: http://localhost:9000
# Production: your Railway backend URL, for example https://brightpath-backend.up.railway.app
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region country code configured in Medusa.
NEXT_PUBLIC_DEFAULT_REGION=dk

# Local storefront URL or deployed Vercel URL.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key. Required for live Stripe checkout UI.
NEXT_PUBLIC_STRIPE_KEY=

# Optional Medusa Cloud/S3 image settings.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
NODE_ENV=development
